{
    "version": 6,

    "configurePresets": [
        {
            "name": "default",
            "displayName": "Clang + Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",

            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ]
}
